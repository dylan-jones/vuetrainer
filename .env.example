# Firebase web app config (Firebase console > Project settings > Your apps).
# These values are public identifiers, not secrets; security comes from Firestore rules.
# Leave blank to run in local-only mode (progress stored in this browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
