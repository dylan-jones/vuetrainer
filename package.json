{
  "name": "vuetrainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "deploy": "npm run build && wrangler pages deploy dist --project-name vuetrainer"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "firebase": "^12.0.0",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vuetify": "^4.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "sass-embedded": "^1.90.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
