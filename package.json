{
  "name": "vuetrainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev",
    "typecheck": "vue-tsc --noEmit && tsc -p worker",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply vuetrainer --remote",
    "db:migrate:local": "wrangler d1 migrations apply vuetrainer --local",
    "dev:api": "wrangler dev --port 8787"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "firebase": "^12.0.0",
    "jose": "^6.2.17",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vuetify": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "sass-embedded": "^1.90.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
